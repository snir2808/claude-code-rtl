{
  "publisher": "local",
  "name": "vscode-bidi-rtl",
  "displayName": "BiDi RTL & Theme for Claude Code and Copilot",
  "description": "RTL direction and a warm reading theme for the Claude Code panel and VS Code's Copilot chat",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/snir2808/claude-code-rtl.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bidi-rtl.applyPatch",
        "title": "BiDi RTL: Apply RTL Patch"
      },
      {
        "command": "bidi-rtl.removePatch",
        "title": "BiDi RTL: Remove RTL Patch"
      },
      {
        "command": "bidi-rtl.toggle",
        "title": "BiDi RTL: Toggle RTL On/Off"
      },
      {
        "command": "bidi-theme.toggle",
        "title": "BiDi Theme: Toggle Warm Theme On/Off"
      },
      {
        "command": "bidi-codex.toggle",
        "title": "BiDi Codex: Toggle Codex Styling On/Off"
      },
      {
        "command": "bidi-codex.copyDiagnostics",
        "title": "BiDi Codex: Copy Diagnostics Script"
      },
      {
        "command": "bidi-usage.toggle",
        "title": "BiDi Usage: Toggle Session Clock On/Off"
      },
      {
        "command": "bidi-usage.refresh",
        "title": "BiDi Usage: Refresh Session Clock"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && npm run compile",
    "vscode:uninstall": "node ./out/uninstall",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "fixture": "npm run compile && node scripts/render-fixture.js",
    "fixture:chat": "npm run compile && node scripts/render-chat-fixture.js",
    "fixture:codex": "npm run compile && node scripts/render-codex-fixture.js",
    "test": "npm run compile && mocha --ui tdd --require out/test/setup.js 'out/test/**/*.test.js'"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
